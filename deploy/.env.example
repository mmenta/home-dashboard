# Copy to .env in this folder. Never commit .env. These stay on the server.

# Home Assistant long-lived token (HA -> profile -> Security -> Long-lived tokens)
HA_TOKEN=replace-with-ha-long-lived-token

# Your DuckDNS token (duckdns.org account page). Your DuckDNS *container* already
# uses this; SWAG needs it too for DNS-validated TLS certs.
DUCKDNS_TOKEN=replace-with-duckdns-token
