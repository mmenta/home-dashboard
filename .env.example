# ---- Backend-for-frontend (server/index.js) ----
# These stay on the server only. They are NEVER sent to the browser.

# URL of your Home Assistant instance, reachable from the Ubuntu VM.
# Use the internal LAN address so traffic never leaves your network.
HA_BASE_URL=http://homeassistant.local:8123

# Long-lived access token from Home Assistant:
# HA profile page -> Security -> Long-lived access tokens -> Create token
HA_TOKEN=replace-with-your-long-lived-token

# Port the BFF listens on (reverse proxy points here)
PORT=8080

# Optional: trust Authelia's forwarded user header so the UI can greet the user.
# Authelia sets Remote-User after a successful login.
TRUST_AUTH_HEADER=true
